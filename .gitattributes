# Normalize line endings: store everything as LF in the repository
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never modify or diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.pptx binary
*.docx binary

# Exclude notebooks from GitHub language statistics
*.ipynb linguist-detectable=false
