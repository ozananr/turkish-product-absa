# Copy this file to .env and fill in your own keys. Never commit .env.
HF_TOKEN=
OPENAI_API_KEY=

# --- LLM pre-labeling with Google Gemini (docs/prelabeling.md) ---
# The code uses the "openai" Python library only as an HTTP client.
# Requests go to Gemini's OpenAI-compatible endpoint below.
# No OpenAI / ChatGPT account is needed.

# Gemini API key from Google AI Studio (project with billing enabled)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# "low" keeps thinking tokens (billed as output) down. Gemini rejects "none". Empty = provider default.
LLM_REASONING_EFFORT=low
